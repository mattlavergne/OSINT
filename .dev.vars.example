# Copy to .dev.vars for local `wrangler dev`, or export as env vars for the Node server.
# All of these are OPTIONAL. GhostTrace is fully functional without any of them —
# every core source is free and keyless.

# https://account.shodan.io/  -> banner/vuln detail beyond the free InternetDB
SHODAN_API_KEY=

# https://www.virustotal.com/gui/my-apikey  -> reputation scoring for domains and IPs
VIRUSTOTAL_API_KEY=

# https://www.abuseipdb.com/account/api  -> abuse confidence score for IPs
ABUSEIPDB_API_KEY=

# https://console.twilio.com/  -> CNAM caller-ID name and post-portability carrier
# for phone lookups. This is the ONLY source here that can return a subscriber or
# business name, and it is billed per lookup (roughly $0.01). US coverage for
# caller name; line-type intelligence is international.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# https://api-dashboard.search.brave.com/  -> runs the search a human would run
# for a phone number and returns the actual titles and snippets, instead of just
# building dork links. The highest-yield technique for naming a business number.
# Free tier: 2,000 queries/month, 1 query/second.
#
# There is no keyless alternative that works from a Worker: DuckDuckGo's HTML
# endpoint returns a bot challenge to datacenter addresses, its Instant Answer
# API has nothing for phone numbers, and public SearxNG instances serve a
# captcha. All three were tested.
BRAVE_SEARCH_API_KEY=
